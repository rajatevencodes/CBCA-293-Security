      <aliases enabled="yes" />
      <column caption="Total Transactions" datatype="integer" default-format="n#,##0;-#,##0" name="[Calculation_7310000000000000001]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNT([customer_id])" />
      </column>
      <column caption="Fraud Transactions" datatype="integer" default-format="n#,##0;-#,##0" name="[Calculation_7310000000000000002]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([is_fraud])" />
      </column>
      <column caption="Fraud Rate %" datatype="real" default-format="p0.00%" name="[Calculation_7310000000000000003]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([is_fraud]) / COUNT([customer_id])" />
      </column>
      <column caption="Fraud Amount $" datatype="real" default-format="c&quot;$&quot;#,##0;-&quot;$&quot;#,##0" name="[Calculation_7310000000000000004]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [is_fraud] = 1 THEN [amount] ELSE 0 END)" />
      </column>
      <column caption="Rule Recall %" datatype="real" default-format="p0.0%" name="[Calculation_7310000000000000005]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([flagged] * [is_fraud]) / SUM([is_fraud])" />
      </column>
      <column caption="Rule Precision %" datatype="real" default-format="p0.0%" name="[Calculation_7310000000000000006]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([flagged] * [is_fraud]) / SUM([flagged])" />
      </column>
